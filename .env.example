APP_ENV=development
APP_NAME=HAGUER Agent Platform
APP_HOST=127.0.0.1
APP_PORT=8000
TIMEZONE=America/Santiago

# Microsoft Entra / Graph
MS_CLIENT_ID=
MS_TENANT_ID=
MS_ENABLE_TEAMS_CHANNELS=false
MS_SCOPES=User.Read Mail.Read Mail.Send Calendars.ReadWrite Chat.Read Team.ReadBasic.All Channel.ReadBasic.All

# Google OAuth Desktop/Web client JSON goes in secrets/google_credentials.json
GOOGLE_CREDENTIALS_FILE=secrets/google_credentials.json
GOOGLE_REDIRECT_URI=http://127.0.0.1:8000/auth/google/callback

# GitHub fine-grained token
GITHUB_TOKEN=

# Production: inject this through a secret manager instead of storing it here.
HAGUER_MASTER_KEY=
