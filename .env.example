APP_NAME=HAGUER Agent Platform REAL
APP_ENV=development
APP_HOST=127.0.0.1
APP_PORT=8000
REQUIRE_APPROVAL_FOR_WRITES=true
TIMEZONE=America/Santiago

# Microsoft Entra ID / Microsoft Graph (Desktop/Public Client)
# Register an app and enable public client/device-code flow.
MS_CLIENT_ID=
MS_TENANT_ID=organizations
MS_ENABLE_TEAMS_CHANNELS=false

# Google Workspace
GOOGLE_CREDENTIALS_FILE=secrets/google_credentials.json
GOOGLE_TOKEN_FILE=data/google_token.json

# GitHub fine-grained PAT or GitHub App token
GITHUB_TOKEN=
GITHUB_API_VERSION=2026-03-10

# Optional AI layer. Core agents work without it.
OPENAI_API_KEY=
