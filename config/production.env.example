APP_ENV=production
DEBUG=false
APP_HOST=127.0.0.1
APP_PORT=8000
DEFAULT_ROLE=READ_ONLY
DEFAULT_ACTOR=identity-proxy
APPROVAL_REQUIRE_DIFFERENT_ACTOR=true
TRUSTED_HOSTS=agents.example.cl
CORS_ORIGINS=https://agents.example.cl
APPROVAL_TTL_SECONDS=300
RATE_AUTH_PER_MINUTE=5
RATE_COMMAND_PER_MINUTE=30
RATE_AGENT_PER_MINUTE=60
RATE_WRITE_PER_MINUTE=10
PROVIDER_TIMEOUT_SECONDS=20
PROVIDER_MAX_RETRIES=3
CIRCUIT_FAILURE_THRESHOLD=4
CIRCUIT_RECOVERY_SECONDS=45
# HAGUER_MASTER_KEY must be injected securely by the runtime/secret manager.
# Microsoft / GitHub credentials must also be injected as environment secrets.
